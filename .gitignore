# .gitignore — что НЕ коммитить в git

# ═══ Виртуальное окружение ═══
.venv/
__pycache__/
*.pyc
*.pyo

# ═══ IDE ═══
.vscode/
.idea/
*.swp
*.swo

# ═══ Сборка ═══
dist/
build/
*.egg-info/

# ═══ ДАННЫЕ (не в git сервера!) ═══
# F49: слэш ВЕДУЩИЙ обязателен — 'workspace/' без него ловит любую папку с таким именем
# на любой глубине и утаскивал в игнор config/templates/workspace/ (шаблоны структуры = исходники).
/workspace/
# _SESSION_LOG.md — рантайм-лог фактов (пишется state_manager в корень репо), НЕ исходник
_SESSION_LOG.md

# ═══ Тесты (I1): КОД версионируется; артефакты прогона — нет ═══
.pytest_cache/
tests/**/__pycache__/
.coverage
.coverage.*
coverage.xml
htmlcov/

# ═══ Внешний coding-агент (MiMo) — рабочая директория, не часть проекта ═══
.mimocode/

# ═══ Веса локальных моделей — зависимость, не исходник ═══
# Каталог объявлен в config/providers.yaml → local.models_dir и наполняется
# scripts/fetch_local_models.py. Гигабайты весов в git не кладут.
/vendor/

# ═══ Секреты ═══
.env
.env.local
*.key
# S9: приватный ключ подписи инстанса. Правило *.key его НЕ ловило — расширение .pem
# (F70: ключ утёк в публичный репозиторий именно через эту щель).
*.pem
instance_key.pem

# ═══ Техническая документация ═══
docs/dev/

# ═══ Туннель (cloudflared) — D11, D31 ═══
# ВНИМАНИЕ: в .gitignore инлайн-комментарии НЕ работают — '#' в середине строки
# становится частью паттерна. Комментарии только на ОТДЕЛЬНОЙ строке.
# локальный бинарь туннеля
bin/cloudflared
# credentials именованного туннеля
*.cloudflared.json
# креды/конфиг cloudflared
.cloudflared/
# D31: может содержать tunnel_token — НЕ коммитить
config/tunnel.yaml
