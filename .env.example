# Ключ доступа к MCP-серверу.
# ВАЖНО: файл .env сервер создаёт САМ при первом старте и печатает ключ один раз.
# Руками ничего придумывать не нужно — этот пример показывает только формат.
#
# Ключ вставляется в коннекторе Claude AI Web: Request headers →
#   authorization: Bearer <ключ>      (или)      x-api-key: <ключ>
# Перевыпуск:  python3 server.py --rotate-key
MCP_AUTH_TOKEN=

# Работа БЕЗ ключа — только локальная разработка и тесты. По умолчанию закрыто (fail-closed).
# MCP_ALLOW_NO_AUTH=1

# Анти-DNS-rebinding: allowlist источников. Включать после живой проверки заголовков,
# которые реально шлёт коннектор (15 §3-тер) — иначе можно отрезать легитимный трафик.
# MCP_ALLOWED_ORIGINS=https://claude.ai
