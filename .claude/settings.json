{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./*.pem)",
      "Read(./**/*.pem)",
      "Read(./*.key)",
      "Read(./**/*.key)",
      "Bash(cat *.env*)",
      "Bash(cat *.pem*)",
      "Bash(cat *.key*)",
      "Bash(grep * .env*)",
      "Bash(grep * *.pem)",
      "Bash(sed * .env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(less *.env*)",
      "Bash(more *.env*)",
      "Bash(strings *.pem)",
      "Bash(strings *.key)",
      "Bash(xxd *.pem)",
      "Bash(base64 *.pem)",
      "Bash(cp .env *)",
      "Bash(cp *.pem *)"
    ]
  }
}
