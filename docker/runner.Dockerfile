# Образ раннера локальных моделей — среда инференса, запертая в контейнере.
#
# Ради чего: torch+rocm с зависимостями это гигабайты в системе пользователя, а падение или
# нехватка памяти в инференсе роняют процесс, в котором он идёт. Здесь и то и другое заперто:
# сервер снаружи переживает и то и другое.
#
# Сборка (контекст — корень проекта, не этот каталог):
#   docker build -f docker/runner.Dockerfile -t video-pipeline-runner .
# Запуск — не руками, а инструментом: media_runner(action='start', mode='docker'); он подставит
# устройства, тома, порт и токен из config/providers.yaml → local.runner.docker.
#
# Системный ROCm НЕ ставится намеренно: библиотеки лежат внутри колеса torch, а от хоста нужен
# только драйвер ядра amdgpu и доступ к /dev/kfd (проверено S23: там 0666, root не требуется).
FROM python:3.14-slim

# Колёса ROCm — гигабайты, и слой с ними должен пережить правку кода. Поэтому сначала манифест
# и установка, и только потом исходники: иначе каждая правка `core/` тянула бы всё заново.
WORKDIR /app
COPY pyproject.toml README.md LICENSE ./
# Заглушки пакетов: колёса ставятся по МАНИФЕСТУ, до всякого исходника. Список зависимостей живёт
# в pyproject и только там — переписывать его сюда значило бы завести вторую копию, которая разойдётся.
RUN mkdir -p core tools pipeline \
    && touch server.py core/__init__.py tools/__init__.py pipeline/__init__.py
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install ".[local,gpu-amd]" --extra-index-url https://download.pytorch.org/whl/rocm7.1

COPY core/ core/
COPY tools/ tools/
COPY config/ config/
COPY server.py ./
RUN pip install --no-deps -e .

# Веса и рабочая область — ТОМАМИ, а не слоями: класть гигабайты в образ значит пересобирать их
# при каждой правке кода. Точки монтирования объявлены в config/providers.yaml → local.runner.docker
# и совпадают с этими путями; внутри раннер видит область по тем же относительным путям, что сервер.
# Скопированный выше `config/` — запасной вариант: боевые декларации приезжают тем же списком
# монтирования, только для чтения, иначе они застыли бы на дне сборки образа.
VOLUME ["/app/workspace", "/app/vendor/models"]

# Раннер слушает петлю КОНТЕЙНЕРА; наружу он выходит только тем портом, что опубликует запускающий,
# и опубликует он его тоже на петлю хоста. За туннель раннер не выставляется никогда.
ENV PYTHONUNBUFFERED=1
EXPOSE 8770

# Живость проверяется без токена — ровно для этого `/health` и отвечает `{"ok": true}` любому:
# «жив ли процесс» не секрет, а вот что он держит поднятым — уже под токеном.
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8770/health', timeout=4).status == 200 else 1)"

# Токен приходит переменной MCP_RUNNER_TOKEN от того, кто поднял контейнер. Без неё раннер не
# встаёт и говорит почему: без токена он исполнял бы задачи любого, кто дотянется до порта.
CMD ["python", "-m", "core.runner", "--container"]
