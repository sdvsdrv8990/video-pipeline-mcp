# Что НЕ попадает в контекст сборки образа раннера.
# Правило то же, что у .gitignore: данные, секреты и гигабайты весов в образ не едут. Веса и
# рабочая область приезжают ТОМАМИ (config/providers.yaml → local.runner.docker.mounts).

# Данные канала — вторая вселенная, в дерево сервера они не попадают и в образ тем более.
workspace/
# Веса моделей: гигабайты, которые обязаны жить томом, а не слоем.
vendor/
# Секреты и личность инстанса.
.env
instance_key.pem
instance_secret.key
config/tunnel.yaml
# Окружение и мусор сборки хоста.
.venv/
.git/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
# Не нужно раннеру: он не сервер и не набор тестов.
docs/
tests/
.github/
