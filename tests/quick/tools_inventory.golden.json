 "fs_create_file": {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": false,
   "readOnlyHint": false
  },
  "description": "Создание файла. Владельца сервер определяет ПО КАТАЛОГУ и всегда возвращает (owner_id + chain). assign_id=true дополнительно выдаёт файлу СОБСТВЕННЫЙ ID: префикс берётся из класса файла (.md→MEM, .json→DATA, .xlsx→TBL, .py→SCRIPT, ассеты→AST), в ответе приходят id, file_class и qualified_id — можно сверить, что префикс соответствует файлу. Без флага файл создаётся без собственного ID (это нормальный режим). Уже зарегистрированный путь отдаёт свой ID (reused=true), второго не заводится.",
  "group": "filesystem",
  "input_schema": {
   "properties": {
    "assign_id": {
     "default": false,
     "description": "Выдать файлу собственный ID (префикс по классу файла) и зарегистрировать его",
     "type": "boolean"
    },
    "content": {
     "description": "Содержимое файла",
     "type": "string"
    },
    "path": {
     "description": "Путь к файлу",
     "type": "string"
    }
   },
   "required": [
    "path"
   ],
   "type": "object"
  },
  "title": "Файлы: создать файл"
 },
 "fs_create_project_structure": {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": false,
   "readOnlyHint": false
  },
  "description": "Материализация структуры каталогов/файлов по шаблону или списку фрагментов (сырые папки/файлы без ID; для узлов проекта с ID и цепочкой владельцев — structure_create)",
  "group": "filesystem",
  "input_schema": {
   "properties": {
    "fragments": {
     "description": "Список фрагментов для создания",
     "items": {
      "properties": {
       "content": {
        "type": "string"
       },
       "name": {
        "type": "string"
       },
       "type": {
        "enum": [
         "directory",
         "file"
        ],
        "type": "string"
       }
      },
      "type": "object"
     },
     "type": "array"
    },
    "template": {
     "description": "Имя шаблона из config/templates/workspace/",
     "type": "string"
    }
   },
   "type": "object"
  },
  "title": "Файлы: структура проекта"
 },
